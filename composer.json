{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zpm-packages/server-access-filament",
    "description": "Filament plugin that exposes server access management resources, pages, and actions for zpm-packages/server-access-laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.0",
        "zpm-packages/server-access-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ZPMPackages\\FilamentSshManagement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZPMPackages\\FilamentSshManagement\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZPMPackages\\FilamentSshManagement\\FilamentSshManagementServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
